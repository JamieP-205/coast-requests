# Copy this to .env for running the app on your own computer.
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=coastadmin
# Make this with: flask --app coast_requests hash-password
ADMIN_PASSWORD_HASH=
# The same secret you type into Netlify's outgoing webhook (32+ characters).
NETLIFY_WEBHOOK_SECRET=
